# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Optional - for persistent cloud storage across devices)
# Set to 'true' to connect to live Firebase Firestore / Authentication
VITE_USE_FIREBASE="false"
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="meeting-room-system.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="meeting-room-system-my"
VITE_FIREBASE_STORAGE_BUCKET="meeting-room-system.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
